{
    "name": "freento/emailslog",
    "version": "1.4.1",
    "description": "Catches all emails sent from a Magento store and additionally logs them to the database.",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "freento/base": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Freento\\EmailsLog\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
